# Optional provider configuration; tests do not require credentials.
GUARDRAIL_RAG_ENV=development
GUARDRAIL_RAG_DATABASE_URL=sqlite:///./guardrail-rag.sqlite3
# Use fake for offline development/tests; use openrouter for live generation.
GUARDRAIL_RAG_PROVIDER=fake
GUARDRAIL_RAG_CORPUS_DIR=data/synthetic
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
